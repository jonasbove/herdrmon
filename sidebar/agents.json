{
  "_comment": "Agents and programs the sidebar labels. Match order: Herdr's detected agent id, then the foreground process name, then the title regex. colour is a Herdr theme palette slot (text, subtext0, overlay0, overlay1, accent, mauve, green, yellow, red, blue, teal, peach). glyph assumes a Nerd Font; text is the plain-Unicode fallback used when [sidebar] glyphs = \"text\". Extend or override from config.toml [agents.<id>].",
  "agents": {
    "claude":     { "label": "Claude Code", "glyph": "✻", "colour": "peach",    "match": { "agent": ["claude"], "process": ["claude"] } },
    "codex":      { "label": "Codex",       "glyph": "Λ", "colour": "text",     "match": { "agent": ["codex"], "process": ["codex"] } },
    "opencode":   { "label": "OpenCode",    "glyph": "◇", "colour": "text",     "match": { "agent": ["opencode"], "process": ["opencode"] } },
    "gemini":     { "label": "Gemini",      "glyph": "✦", "colour": "blue",     "match": { "agent": ["gemini"], "process": ["gemini"] } },
    "hermes":     { "label": "Hermes",      "glyph": "☤", "colour": "blue",     "match": { "agent": ["hermes"], "process": ["hermes"] } },
    "aider":      { "label": "Aider",       "glyph": "◭", "colour": "green",    "match": { "agent": ["aider"], "process": ["aider"], "title": "^aider\\b" } },
    "goose":      { "label": "Goose",       "glyph": "⋎", "colour": "text",     "match": { "agent": ["goose"], "process": ["goose"] } },
    "amp":        { "label": "Amp",         "glyph": "Ʌ", "colour": "red",      "match": { "agent": ["amp"], "process": ["amp"] } },
    "cursor":     { "label": "Cursor",      "glyph": "◆", "colour": "text",     "match": { "agent": ["cursor", "cursor-agent"], "process": ["cursor-agent"] } },
    "crush":      { "label": "Crush",       "glyph": "◉", "colour": "mauve",    "match": { "agent": ["crush"], "process": ["crush"] } },
    "qwen":       { "label": "Qwen",        "glyph": "Ϙ", "colour": "mauve",    "match": { "agent": ["qwen"], "process": ["qwen"] } },
    "copilot":    { "label": "Copilot",     "glyph": "⊙", "colour": "text",     "match": { "agent": ["copilot"], "process": ["copilot"] } },
    "pi":         { "label": "Pi",          "glyph": "π", "colour": "text",     "match": { "agent": ["pi"], "process": ["pi"] } },
    "kiro":       { "label": "Kiro",        "glyph": "Ω", "colour": "mauve",    "match": { "agent": ["kiro"], "process": ["kiro", "kiro-cli"] } },
    "droid":      { "label": "Droid",       "glyph": "◬", "colour": "peach",    "match": { "agent": ["droid"], "process": ["droid"] } },
    "cline":      { "label": "Cline",       "glyph": "∇", "colour": "text",     "match": { "agent": ["cline"], "process": ["cline"] } },
    "devin":      { "label": "Devin",       "glyph": "ꓓ", "colour": "teal",     "match": { "agent": ["devin"], "process": ["devin"] } },
    "agy":        { "label": "Antigravity", "glyph": "△", "colour": "blue",     "match": { "agent": ["agy"], "process": ["agy"] } },
    "omp":        { "label": "Oh My Pi",    "glyph": "Π", "colour": "text",     "match": { "agent": ["omp"], "process": ["omp"] } },
    "kimi":       { "label": "Kimi",        "glyph": "✧", "colour": "blue",     "match": { "agent": ["kimi"], "process": ["kimi"] } },
    "kilo":       { "label": "Kilo",        "glyph": "♟", "colour": "yellow",   "match": { "agent": ["kilo"], "process": ["kilo"] } },
    "grok":       { "label": "Grok",        "glyph": "✖", "colour": "text",     "match": { "agent": ["grok"], "process": ["grok"] } },
    "mastracode": { "label": "Mastra",      "glyph": "∑", "colour": "text",     "match": { "agent": ["mastracode"], "process": ["mastracode"] } },
    "qodercli":   { "label": "Qoder",       "glyph": "Ǫ", "colour": "green",    "match": { "agent": ["qodercli"], "process": ["qodercli"] } },
    "letta":      { "label": "Letta",       "glyph": "λ", "colour": "text",     "match": { "agent": ["letta"], "process": ["letta"] } },
    "maki":       { "label": "Maki",        "glyph": "✳", "colour": "text",     "match": { "agent": ["maki"], "process": ["maki"] } },
    "muse":       { "label": "Muse",        "glyph": "♪", "colour": "mauve",    "match": { "agent": ["muse"], "process": ["muse"] } }
  },
  "programs": {
    "neovim":     { "label": "neovim",      "glyph": "", "text": "ν", "colour": "green",    "match": { "process": ["nvim"] } },
    "vim":        { "label": "vim",         "glyph": "", "text": "v", "colour": "green",    "match": { "process": ["vim", "vi", "gvim"] } },
    "helix":      { "label": "helix",       "glyph": "ℏ", "text": "ℏ", "colour": "mauve",   "match": { "process": ["hx", "helix"] } },
    "git":        { "label": "git",         "glyph": "", "text": "±", "colour": "peach",    "match": { "process": ["git", "lazygit", "tig", "gitui"] } },
    "ssh":        { "label": "ssh",         "glyph": "", "text": "⇄", "colour": "teal",     "match": { "process": ["ssh", "mosh", "mosh-client"] } },
    "python":     { "label": "python",      "glyph": "", "text": "py", "colour": "blue",    "match": { "process": ["python", "python3", "ipython", "uv"] } },
    "node":       { "label": "node",        "glyph": "", "text": "js", "colour": "green",   "match": { "process": ["node", "bun", "deno", "npm", "pnpm"] } },
    "go":         { "label": "go",          "glyph": "", "text": "go", "colour": "teal",    "match": { "process": ["go"] } },
    "cargo":      { "label": "cargo",       "glyph": "", "text": "rs", "colour": "peach",   "match": { "process": ["cargo", "rustc"] } },
    "docker":     { "label": "docker",      "glyph": "", "text": "▣", "colour": "blue",     "match": { "process": ["docker", "lazydocker", "podman"] } },
    "monitor":    { "label": "top",         "glyph": "", "text": "▤", "colour": "yellow",   "match": { "process": ["btop", "htop", "top"] } },
    "files":      { "label": "files",       "glyph": "", "text": "▭", "colour": "yellow",   "match": { "process": ["yazi", "lf", "ranger", "nnn"] } },
    "shell":      { "label": "shell",       "glyph": "", "text": "$", "colour": "overlay1", "hide": true, "match": { "process": ["bash", "zsh", "fish", "sh", "dash", "nu", "elvish", "xonsh"] } }
  }
}
